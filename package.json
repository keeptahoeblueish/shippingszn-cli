{
  "name": "shippingszn",
  "version": "0.11.0",
  "description": "Read-only launch inspector for AI-built apps.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shippingszn": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "launch",
    "launch-inspector",
    "checklist",
    "preflight",
    "security",
    "audit",
    "scanner",
    "ship",
    "shippingszn",
    "vibe-coder"
  ],
  "homepage": "https://shippingszn.com",
  "bugs": {
    "url": "https://github.com/keeptahoeblueish/shippingszn-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keeptahoeblueish/shippingszn-cli.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "tsx ./src/index.ts",
    "start": "node ./dist/index.js",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:artifact": "node scripts/verify-export.mjs --artifact",
    "verify:release": "npm run verify:export && npm run typecheck && npm test && npm run build && node scripts/verify-export.mjs --release",
    "prepublishOnly": "npm run verify:export && npm run clean && npm run typecheck && npm test && npm run build && node scripts/verify-export.mjs --release"
  },
  "devDependencies": {
    "@types/node": "20.19.28",
    "esbuild": "0.28.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
