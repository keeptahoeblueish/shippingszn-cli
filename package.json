{
  "name": "shippingszn",
  "version": "0.10.1",
  "description": "Read-only launch inspector for AI-built apps.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shippingszn": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "launch",
    "launch-inspector",
    "checklist",
    "preflight",
    "security",
    "audit",
    "scanner",
    "ship",
    "shippingszn",
    "vibe-coder"
  ],
  "homepage": "https://shippingszn.com",
  "bugs": {
    "url": "https://github.com/keeptahoeblueish/shippingszn-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keeptahoeblueish/shippingszn-cli"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "tsx ./src/index.ts",
    "start": "node ./dist/index.js",
    "test": "tsx --test ./test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
